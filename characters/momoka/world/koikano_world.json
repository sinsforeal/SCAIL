 "club": {
  "name": "演劇部",
  "facts": [
   {
    "text": "Momoka founded the theater club and has led it as president.",
    "receipts": [
     {
      "id": "d05_01:0353",
      "anchor": "演劇部は百花が作った"
     }
    ]
   },
   {
    "text": "The club is tiny: she counts it as just two people.",
    "receipts": [
     {
      "id": "d05_01:0370",
      "anchor": "二人だけ"
     }
    ]
   },
   {
    "text": "Its club room faces the literary club's room across the hall; the club room image (BG02) serves both.",
    "receipts": [
     {
      "id": "03_01:1468",
      "anchor": "真向かい",
      "bg": "BG02"
     },
     {
      "id": "02_01:4984",
      "anchor": "演劇部の部室",
      "bg": "BG02"
     }
    ]
   },
   {
    "text": "The literary club (文芸部) sits next to it; 一悟 is its president (context only, the world never acts for him).",
    "receipts": [
     {
      "id": "01_01:0787",
      "anchor": "文芸部の部室"
     }
    ]
   },
   {
    "text": "Both clubs work together on the culture festival and stay overnight at school the day before.",
    "receipts": [
     {
      "id": "08_01:0109",
      "anchor": "文芸部と演劇部は学校へ泊まって"
     }
    ]
   }
  ],
  "room": {
   "place": "club_room"
  }
 },
 "anchors": [
  {
   "id": "school_day",
   "kind": "weekly",
   "place_ids": [
    "classroom",
    "hallway",
    "entrance",
    "club_room"
   ],
   "facts": [
    {
     "text": "Lessons by day, lunch at midday, club after lessons; no fixed weekday for the club in the record.",
     "receipts": [
      {
       "id": "05_01:3993",
       "anchor": "放課後に部室",
       "bg": "BG02"
      },
      {
       "id": "c05_01:0281",
       "anchor": "昼休み"
      },
      {
       "id": "d03_01:0007",
       "anchor": "部活を休んだ"
      }
     ]
    },
    {
     "text": "Lunch can be bought at the school shop (購買部) by the entrance.",
     "receipts": [
      {
       "id": "02_01:1216",
       "anchor": "購買部でお昼ごはん",
       "bg": "BG10"
      },
      {
       "id": "01_01:4318",
       "anchor": "購買部"
      }
     ]
    }
   ]
  },
  {
   "id": "club_stop",
   "kind": "before_exam",
   "place_ids": [
    "hallway",
    "entrance"
   ],
   "facts": [
    {
     "text": "Club activity stops for the week before the midterms.",
     "receipts": [
      {
       "id": "a05_01:0619",
       "anchor": "中間テストの一週間前"
      },
      {
       "id": "a05_01:0940",
       "anchor": "部活動停止期間"
      },
      {
       "id": "d07_01:0070",
       "anchor": "部活動停止期間"
      }
     ]
    },
    {
     "text": "The same stop comes before the finals.",
     "receipts": [
      {
       "id": "a03_01:1820",
       "anchor": "期末テストのために部活動が停止"
      }
     ]
    }
   ]
  },
  {
   "id": "exams",
   "kind": "rare_fixture",
   "place_ids": [
    "classroom"
   ],
   "facts": [
    {
     "text": "Midterms and finals exist, with a blank gap between them.",
     "receipts": [
      {
       "id": "a03_01:1108",
       "anchor": "中間テストと期末テストの間"
      }
     ]
    },
    {
     "text": "Momoka sits them and hopes to lose her red marks.",
     "receipts": [
      {
       "id": "d08_01:0535",
       "anchor": "中間テスト"
      }
     ]
    },
    {
     "text": "Cadence: an exam week about once every 8 weeks of the sim.",
     "kind": "parameter",
     "basis": "The record shows both exams but gives no dates; the owner draws them rarely (design 3.2). A tuning number, not a record fact.",
     "value_weeks": 8
    }
   ]
  },
  {
   "id": "presidents_meeting",
   "kind": "rare_fixture",
   "place_ids": [],
   "facts": [
    {
     "text": "A presidents' meeting (部長会議) is held on a school afternoon, after the midterms.",
     "receipts": [
      {
       "id": "d06_01:1590",
       "anchor": "部長会議"
      },
      {
       "id": "d06_01:1392",
       "anchor": "今日の放課後"
      }
     ]
    },
    {
     "text": "Club presidents otherwise meet each other only there.",
     "receipts": [
      {
       "id": "02_01:3920",
       "anchor": "部長会議で顔を見る"
      }
     ]
    }
   ],
   "hole": "The record shows no room for the meeting; no place is fixed."
  },
  {
   "id": "weekend_at_her_house",
   "kind": "weekly",
   "place_ids": [],
   "facts": [
    {
     "text": "The club gathers at Momoka's house at the weekend when there is work to do.",
     "receipts": [
      {
       "id": "b12_01:0111",
       "anchor": "百花ちゃんの家に集まって"
      }
     ]
    },
    {
     "text": "A club training camp (合宿) at her house has happened.",
     "receipts": [
      {
       "id": "b01_01:1449",
       "anchor": "百花ちゃん家の合宿"
      }
     ]
    }
   ],
   "hole": "The record names no background for her living room; no place id is fixed for these gatherings."
  },
  {
   "id": "culture_festival",
   "kind": "rare_fixture",
   "place_ids": [
    "gym",
    "stage",
    "club_room"
   ],
   "facts": [
    {
     "text": "The culture festival runs two days.",
     "receipts": [
      {
       "id": "08_01:3870",
       "anchor": "文化祭の二日間"
      }
     ]
    },
    {
     "text": "The day before, both clubs stay at school for last preparations.",
     "receipts": [
      {
       "id": "08_01:0109",
       "anchor": "学校へ泊まって最終準備"
      }
     ]
    }
   ]
  }
